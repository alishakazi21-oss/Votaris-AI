# Voltaris AI – Environment Variables Example
# Copy this file to .env and fill in your values. Never commit .env to version control.

# ─── App ───────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/voltaris.db

# ─── Weather API ───────────────────────────────────────────────────────────
# Open-Meteo is free and requires no API key for standard forecasts.
# Set WEATHER_API_KEY if you choose a paid provider (e.g., OpenWeatherMap).
WEATHER_API_KEY=

# ─── AI Assistant (Optional LLM) ───────────────────────────────────────────
# Leave blank to fall back to the rule-based assistant.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=512

# ─── Electricity Tariffs (₹ / kWh) ────────────────────────────────────────
TARIFF_OFF_PEAK=4.50
TARIFF_MID_PEAK=7.20
TARIFF_ON_PEAK=10.80

# ─── Grid Emission Factor ──────────────────────────────────────────────────
GRID_EMISSION_FACTOR_KG_PER_KWH=0.82   # India average CEA 2024
